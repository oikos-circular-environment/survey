                        {
                          "type": "text",
                          "id": "lexdt",
                          "name": "Result",
                          "fill": "$W:--foreground",
                          "content": "Ts = (4,2 − 1) / 4 = 0,80",
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "700"
