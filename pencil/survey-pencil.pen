                        {
                          "type": "text",
                          "id": "ZncJ8",
                          "name": "Label",
                          "fill": "$W:--muted-foreground",
                          "content": "SATISFAÇÃO (TS)",
                          "fontFamily": "Inter",
                          "fontSize": 11,
                          "fontWeight": "700",
                          "letterSpacing": 0.4
                        },
                        {
                          "type": "frame",
                          "id": "i8jv9",
                          "name": "Formula Chip",
                          "fill": "$W:--card",
                          "cornerRadius": 6,
                          "padding": [
                            6,
                            10
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "Sj4zd",
                              "name": "Formula",
                              "fill": "$W:--foreground",
                              "content": "Ts = (média − 1) / 4",
                              "fontFamily": "Roboto Mono",
                              "fontSize": 12,
                              "fontWeight": "500"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "s3qma8",
                          "name": "Substitution",
                          "fill": "$W:--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "média = 4,2 (escala de concordância 1–5, resposta pós-suíte)",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "rectangle",
                          "id": "SGTTO",
                          "name": "Divider",
                          "fill": "$W:--border",
                          "width": "fill_container",
