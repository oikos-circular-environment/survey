                      "padding": 16,
                      "children": [
                        {
                          "type": "text",
                          "id": "iLXXn",
                          "name": "Label",
                          "fill": "$W:--muted-foreground",
                          "content": "EFICIÊNCIA (TF)",
                          "fontFamily": "Inter",
                          "fontSize": 11,
                          "fontWeight": "700",
                          "letterSpacing": 0.4
                        },
                        {
                          "type": "frame",
                          "id": "znUK3",
                          "name": "Formula Chip",
                          "fill": "$W:--card",
                          "cornerRadius": 6,
                          "padding": [
                            6,
                            10
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "qjWrK",
                              "name": "Formula",
                              "fill": "$W:--foreground",
                              "content": "Tf = 1 − tmed / (tmax − tmin)",
                              "fontFamily": "Roboto Mono",
                              "fontSize": 12,
                              "fontWeight": "500"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "BR93l",
                          "name": "Substitution",
                          "fill": "$W:--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "tmed = 3,17 min (S1) · tmin = 1,33 min · tmax = 11,50 min",
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "KfGMq",
                          "name": "Note",
                          "fill": "$W:--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "tmin/tmax são os extremos observados em todo o estudo, não só nesta suíte — por isso valem para o cálculo de qualquer suíte.",
                          "fontFamily": "Inter",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "rectangle",
                          "id": "bY3VF",
                          "name": "Divider",
                          "fill": "$W:--border",
                          "width": "fill_container",
                          "height": 1
                        },
                        {
                          "type": "text",
                          "id": "qku7G",
                          "name": "Result",
                          "fill": "$W:--foreground",
                          "content": "Tf = 1 − 3,17/(11,50−1,33) = 0,69",
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "700"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "UJB4E",
                  "name": "Formula Grid Row 2",
                  "width": "fill_container",
