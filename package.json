{
	"name": "survey",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6",
			"lucide-react": "^1.23.0",
			"next": "^16.2.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"sonner": "^2.0.7",
			"@trpc/server": "^11.18.0",
			"@trpc/client": "^11.18.0",
			"@tailwindcss/postcss": "^4.3.2",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.2"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"dev:web": "turbo run dev -F web",
		"db:push": "turbo run db:push -F @survey/db",
		"db:studio": "turbo run db:studio -F @survey/db",
		"db:generate": "turbo run db:generate -F @survey/db",
		"db:migrate": "turbo run db:migrate -F @survey/db",
		"db:seed": "turbo run db:seed -F @survey/db",
		"db:seed:demo": "turbo run db:seed:demo -F @survey/db",
		"db:start": "docker compose up -d mysql",
		"db:watch": "docker compose up mysql",
		"db:stop": "docker compose stop mysql",
		"db:down": "docker compose down mysql",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@survey/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@survey/config": "workspace:*",
		"@types/node": "^22.13.14",
		"lefthook": "^2.1.9",
		"turbo": "^2.10.2",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
