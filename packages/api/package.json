{
	"name": "@oikos-circular-environment/survey-api",
	"version": "1.1.18",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oikos-circular-environment/survey.git",
		"directory": "packages/api"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"build": "tsc --emitDeclarationOnly --declaration --outDir dist",
		"test": "bun test"
	},
	"dependencies": {
		"@oikos-circular-environment/survey-db": "workspace:*",
		"@trpc/server": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@survey/config": "workspace:*",
		"@survey/env": "workspace:*",
		"@trpc/client": "catalog:",
		"@types/bun": "^1.3.14",
		"better-auth": "^1.6.25",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"next": "catalog:",
		"typescript": "catalog:"
	}
}
