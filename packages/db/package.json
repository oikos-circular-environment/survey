{
	"name": "@oikos-circular-environment/survey-db",
	"version": "0.1.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oikos-circular-environment/survey.git",
		"directory": "packages/db"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"build": "tsc --emitDeclarationOnly --declaration --outDir dist",
		"test": "bun test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun run src/seed/run.ts",
		"db:seed:demo": "bun run src/factories/demo-seed.ts"
	},
	"dependencies": {
		"@survey/env": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"mysql2": "^3.22.5",
		"ulid": "^2.4.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.5.0",
		"@survey/config": "workspace:*",
		"@types/bun": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"typescript": "catalog:"
	}
}
